---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; alt: string; eager?: boolean; }
const { src, alt, eager = false } = Astro.props;
---
<Image src={src} alt={alt} layout="constrained" width={800}
    widths={[320, 640, 800]} sizes="(max-width: 700px) calc(100vw - 64px), 800px"
    format="webp" loading={eager ? "eager" : "lazy"} decoding="async" />
<style>
    img { width: 100%; height: auto; border-radius: 12px; margin-block: 1rem; }
</style>
