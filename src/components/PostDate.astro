---
interface Props {
    date: Date;
    locale?: "en" | "bn";
}

const { date, locale = "en" } = Astro.props;
const formatted = new Intl.DateTimeFormat(locale === "bn" ? "bn-BD" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
}).format(date);
---

<time datetime={date.toISOString()}>{formatted}</time>
