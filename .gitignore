# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.npm/

# Astro build output and generated types
/dist/
/.astro/
.cache/
.vite/
*.tsbuildinfo

# Local environment files (keep shareable templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs and runtime files
*.log
*.pid
*.pid.lock

# Test and coverage output
/coverage/
.nyc_output/
/playwright-report/
/test-results/

# Local reports, generated artifacts, and scratch work
/output/
/tmp/
/temp/

# Python helpers and local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Editor-specific local state
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~

# Operating-system files
.DS_Store
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
